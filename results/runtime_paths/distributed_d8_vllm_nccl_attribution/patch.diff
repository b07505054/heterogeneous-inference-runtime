--- /dev/null
+++ b/vllm/tp_profile.py
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+
+import os
+from contextlib import nullcontext
+
+import torch
+
+_ENV_FLAG = "VLLM_TP_PROFILE_NVTX"
+
+
+def enabled() -> bool:
+    return os.environ.get(_ENV_FLAG) == "1"
+
+
+def _range(label: str):
+    if not enabled() or not torch.cuda.is_available():
+        return nullcontext()
+    return torch.cuda.nvtx.range(label)
+
+
+def tensor_bytes(tensor: torch.Tensor) -> int:
+    return tensor.numel() * tensor.element_size()
+
+
+def nccl_range(collective: str, tensor: torch.Tensor, world_size: int):
+    if not enabled():
+        return nullcontext()
+    label = (
+        f"vllm.nccl collective={collective} "
+        f"numel={tensor.numel()} element_size={tensor.element_size()} "
+        f"bytes={tensor_bytes(tensor)} dtype={tensor.dtype} "
+        f"world_size={world_size}"
+    )
+    return _range(label)
+
+
+def _sanitize_req_id(req_id: str) -> str:
+    return str(req_id).replace(" ", "_").replace("|", "_")
+
+
+def step_range(phase: str, step_id: int, tokens: int, requests: int,
+               ctx_tokens: int, ctx_requests: int, decode_tokens: int,
+               decode_requests: int, req_ids: list[str] | None = None):
+    if not enabled():
+        return nullcontext()
+    req_label = ""
+    if req_ids:
+        req_label = " req_ids=" + "|".join(_sanitize_req_id(r) for r in req_ids)
+    label = (
+        f"vllm.step phase={phase} step={step_id} tokens={tokens} "
+        f"requests={requests} ctx_tokens={ctx_tokens} "
+        f"ctx_requests={ctx_requests} decode_tokens={decode_tokens} "
+        f"decode_requests={decode_requests}{req_label}"
+    )
+    return _range(label)
